Options -MultiViews

# [FIX-ED-3] Cabeceras de seguridad HTTP — antes ausentes por completo.
# CSP deliberadamente permisiva en script-src/style-src porque la app usa
# extensivamente atributos onclick/onmouseover y <script> inline en las
# vistas (incluidas las cargadas dinámicamente por PJAX) — un CSP estricto
# sin 'unsafe-inline' rompería la interfaz completa. Aun así cubre lo
# importante: frame-ancestors (clickjacking), object-src y base-uri.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # [OPTIMIZACIÓN RED MÓVIL] Caché persistente de recursos estáticos (CSS, JS, Fuentes, Imágenes)
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>

RewriteEngine On

# ==============================================================
# SEGURIDAD CLOUDFLARE TUNNEL (ACCESO WEB COMPLETO)
# Permite acceso al quiosco, inicio de sesión y portal del pasante/personal.
# Bloquea acceso directo a archivos sensibles o de configuración (.env, .git, etc.)
# ==============================================================
RewriteRule ^(\.git|\.env|composer\.|package\.) - [F,L]


# Servir archivos estáticos de uploads/ directamente sin pasar por el router
RewriteRule ^uploads/ - [L,NC]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

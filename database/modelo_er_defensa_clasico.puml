  //==========================================================================
  D01 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="tiene rol"];
  usuarios -> D01 [dir=none, label="N"];
  D01 -> roles    [dir=none, label="1"];

  D02 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="pertenece a"];
  usuarios -> D02       [dir=none, label="N"];
  D02 -> departamentos  [dir=none, label="0..1"];

  D03 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="posee perfil"];
  usuarios -> D03          [dir=none, label="1"];
  D03 -> datos_personales  [dir=none, label="1"];

  D08 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="es pasante"];
  usuarios -> D08       [dir=none, label="1"];
  D08 -> datos_pasante  [dir=none, label="1"];

  D09 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="procede de"];

  D10 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="cursa en período"];
  datos_pasante -> D10           [dir=none, label="N"];
  D10 -> periodos_academicos     [dir=none, label="0..1"];

  D11 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="tutor actual"];
  datos_pasante -> D11 [dir=none, label="N"];
  D11 -> usuarios      [dir=none, label="0..1"];

  D12 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="depto actual"];
  datos_pasante -> D12  [dir=none, label="N"];
  D12 -> departamentos  [dir=none, label="0..1"];

  D13 [shape=diamond, style=filled, fillcolor="#FDE9D9", color="#C0504D", label="es asignado"];
  usuarios -> D13     [dir=none, label="N\n(pasante)"];

@startuml uc_tutor
' =========================================================
' DIAGRAMA DE CASOS DE USO — Tutor
' Sistema de Gestion de Pasantes (SGP)
' Defensa · Julio 2026
' =========================================================

left to right direction
skinparam usecase {
  BackgroundColor      #F0FDF4
  BorderColor          #15803D
  FontColor            #1C1C1C
  FontSize             11
  FontName             Arial
}
skinparam actor {
  BackgroundColor      #DCFCE7
  BorderColor          #15803D
  FontColor            #14532D
  FontSize             12
  FontName             Arial
}
skinparam rectangle {
  BackgroundColor      #F7FEF9
  BorderColor          #16A34A
  BorderThickness      2.5
  FontColor            #14532D
  FontSize             14
  FontName             Arial Bold
}
skinparam ArrowColor   #15803D
skinparam ArrowThickness 1.3
skinparam shadowing    false
skinparam note {
  BackgroundColor #DCFCE7
  BorderColor     #22C55E
  FontSize        9
}

title <b>Casos de Uso — Tutor</b>\nSGP · Sistema de Gestion de Pasantes

actor "Tutor" as TUT

rectangle "SGP — Sistema de Gestion de Pasantes" {

  ' ---- AUTENTICACION ----
  package "Acceso al Sistema" {
    (Iniciar sesion) as UC_LOGIN
    (Cerrar sesion) as UC_LOGOUT
  }

  ' ---- SUPERVISION ----
  package "Supervision de Pasantes" {
    (Ver lista de pasantes asignados) as UC_LIST_PAS
    (Ver datos del pasante) as UC_VER_PAS
    (Ver progreso de horas acumuladas) as UC_PROGRESO
    (Ver almanaque de pasante) as UC_ALMANAQUE
  }

  ' ---- ASISTENCIAS ----
  package "Asistencias" {
    (Ver asistencias del pasante) as UC_VER_ATT
    (Ver detalle de dia especifico) as UC_VER_DIA
  }

  ' ---- EVALUACIONES ----
  package "Evaluaciones" {
    (Registrar evaluacion de pasante) as UC_EVA_CREATE
    (Ver historial de evaluaciones) as UC_EVA_LIST
    (Editar evaluacion registrada) as UC_EVA_EDIT
  }

  ' ---- ACTIVIDADES ----
  package "Actividades del Pasante" {
    (Revisar actividades registradas) as UC_ACT_REVIEW
    (Aprobar / observar actividad) as UC_ACT_APPROVE
  }

  ' ---- REPORTES ----
  package "Reportes" {
    (Ver reporte de asistencia) as UC_REPORTE
    (Exportar PDF de pasante) as UC_PDF
  }

}

' ---- ASOCIACIONES ----
TUT --> UC_LOGIN
TUT --> UC_LOGOUT

TUT --> UC_LIST_PAS
TUT --> UC_VER_PAS
TUT --> UC_PROGRESO
TUT --> UC_ALMANAQUE

TUT --> UC_VER_ATT
TUT --> UC_VER_DIA

TUT --> UC_EVA_CREATE
TUT --> UC_EVA_LIST
TUT --> UC_EVA_EDIT

TUT --> UC_ACT_REVIEW
TUT --> UC_ACT_APPROVE

TUT --> UC_REPORTE
TUT --> UC_PDF

' ---- INCLUDE ----
UC_REPORTE ..> UC_PDF      : <<include>>
UC_VER_DIA ..> UC_VER_ATT  : <<include>>
UC_EVA_EDIT ..> UC_EVA_LIST : <<include>>

note right of UC_PROGRESO
  Muestra barra de avance:
  horas_acumuladas vs
  horas_meta (1440 h)
end note

note right of UC_EVA_CREATE
  Califica al pasante en
  puntualidad, actitud,
  desempeno y otros criterios
end note

@enduml
